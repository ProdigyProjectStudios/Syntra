{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.16.1",
  "engines": { "node": ">=22.6.0" },
  "scripts": {
    "test": "pnpm --filter @workspace/consultation test",
    "test:agentplace": "node integrations/agentplace/validate.mjs",
    "test:voice": "node --experimental-strip-types --test artifacts/digital-prodigy/tests/*.test.ts artifacts/api-server/tests/*.test.ts",
    "test:intelligence": "node scripts/test-intelligence.mjs",
    "test:layout": "node scripts/frontend-layout-check.mjs",
    "test:browser": "node scripts/browser-workflow-check.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
